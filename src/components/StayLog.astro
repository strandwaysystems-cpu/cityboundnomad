---
import type { Stay } from '../data/stays';
import Icon from './Icon.astro';

interface Props {
  stay: Stay;
  /** 2 under a page H1, 3 when nested under a section heading. */
  level?: 2 | 3;
}

const { stay, level = 2 } = Astro.props;
const Name = `h${level}` as 'h2' | 'h3';
const ColTitle = `h${level + 1}` as 'h3' | 'h4';
---

<article class="stay">
  <header class="stay__head">
    <div>
      <Name class="display-sm">{stay.name}</Name>
      <p class="body-sm">
        {stay.city}, {stay.country} · {stay.stayType}
        <br />
        {stay.pricePerNight}
        {stay.stayDate && ` · ${stay.stayDate}`}
      </p>
    </div>
    <p class="stay__rating">
      <Icon name="star" size={14} color="var(--c-accent)" />
      <strong>{stay.rating.toFixed(1)}</strong>
      <span class="body-sm">/5</span>
    </p>
  </header>

  <div class="stay__cols">
    {
      stay.pros.length > 0 && (
        <div>
          <ColTitle class="stay__col-title">Pros</ColTitle>
          <ul class="pro-con">
            {stay.pros.map((p) => (
              <li>
                <span class="pro-con__mark pro-con__mark--pro">+</span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      stay.cons.length > 0 && (
        <div>
          <ColTitle class="stay__col-title">Cons</ColTitle>
          <ul class="pro-con">
            {stay.cons.map((c) => (
              <li>
                <span class="pro-con__mark pro-con__mark--con">−</span>
                {c}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <footer class="stay__verdict">
    <p>“{stay.verdict}”</p>
    {
      stay.bookingUrl && (
        <a class="link-cta" href={stay.bookingUrl} target="_blank" rel="noopener sponsored">
          Book <Icon name="external-link" size={11} />
        </a>
      )
    }
  </footer>
</article>
