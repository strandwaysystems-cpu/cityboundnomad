---
import type { City } from '../data/cities';
import Icon from './Icon.astro';

interface Props {
  city: City;
  /** When given the whole card becomes a link to the city's page. */
  href?: string;
  /** Counts shown on the card foot, e.g. "2 cafés · 1 stay" */
  meta?: string;
}

const { city, href, meta } = Astro.props;

const cost =
  city.costPerDayMin && city.costPerDayMax
    ? `€${city.costPerDayMin}–€${city.costPerDayMax}/day`
    : null;

const Tag = href ? 'a' : 'article';
---

<Tag class="card-hover feature-card" href={href}>
  {
    city.image ? (
      <div class="city-card__media zoom-frame">
        <img src={city.image} alt={`${city.name}, ${city.country}`} loading="lazy" decoding="async" />
        {cost && <p class="city-card__cost">{cost}</p>}
      </div>
    ) : (
      <div class="city-card__media city-card__media--empty">
        <span aria-hidden="true">{city.flag}</span>
        {cost && <p class="city-card__cost">{cost}</p>}
      </div>
    )
  }
  <div class="city-card__body">
    <div class="city-card__title">
      <span aria-hidden="true" style="font-size:1.25rem">{city.flag}</span>
      <h3>{city.name}</h3>
      <span class="body-sm">{city.country}</span>
    </div>
    <p class="body-sm" style="margin-bottom:1rem">{city.description}</p>
    <ul class="tag-row">
      {city.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="card-foot">
      <span class="body-sm">
        {meta ?? (city.returnedOn?.length ? 'Returned on a later trip' : '')}
      </span>
      {href ? <Icon name="arrow-right" size={14} color="var(--c-accent)" /> : <Icon name="map-pin" size={14} color="var(--c-accent)" />}
    </div>
  </div>
</Tag>
