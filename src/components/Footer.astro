---
import { SITE, SOCIAL, NAV, LEGAL_NAV, CONTACT } from '../data/site';

const year = new Date().getFullYear();

const LISTS = [
  { label: 'Cafés & bars', href: '/cafes' },
  { label: 'Tours', href: '/tours' },
  { label: 'Stays', href: '/stays' },
  { label: 'Wardrobe', href: '/wardrobe' },
  { label: 'Hair & skin', href: '/grooming' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2>{SITE.name}</h2>
        <p class="body-sm" style="color: oklch(0.6 0.008 65); line-height: 1.7;">
          A personal catalogue by {SITE.author}. The places I've been and the things I use — from
          Atlantic Canada to Europe's cobblestone streets.
        </p>
        <p class="footer-note">{SITE.parentEntity}</p>
      </div>

      <div>
        <span class="eyebrow">Sections</span>
        <ul class="footer-links">
          {
            NAV.map((link) => (
              <li>
                <a href={link.href} class="footer-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <span class="eyebrow">The lists</span>
        <ul class="footer-links">
          {
            LISTS.map((link) => (
              <li>
                <a href={link.href} class="footer-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <span class="eyebrow">Elsewhere</span>
        <ul class="footer-links">
          <li>
            <a
              href={SOCIAL.instagram}
              class="footer-link"
              target="_blank"
              rel="noopener noreferrer">Instagram</a
            >
          </li>
          <li>
            <a href={SOCIAL.tiktok} class="footer-link" target="_blank" rel="noopener noreferrer"
              >TikTok</a
            >
          </li>
          <li><a href={`mailto:${CONTACT.email}`} class="footer-link">Email</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <div class="footer-legal">
        {LEGAL_NAV.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
  </div>
</footer>
