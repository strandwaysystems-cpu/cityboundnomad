---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, NAV } from '../data/site';
---

<BaseLayout title={`Page not found | ${SITE.name}`} noindex>
  <section class="legal">
    <div class="container container--narrow">
      <p class="pillar-label mb-1">404</p>
      <h1>Nothing at this address.</h1>
      <p>
        Which is on brand, but not much use to you. The page you were after has moved or never
        existed.
      </p>
      <ul class="mt-3" style="list-style:none; padding:0; display:flex; gap:1.5rem; flex-wrap:wrap">
        <li><a href="/" style="color:var(--c-accent)">Home</a></li>
        {NAV.map((link) => <li><a href={link.href} style="color:var(--c-accent)">{link.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
