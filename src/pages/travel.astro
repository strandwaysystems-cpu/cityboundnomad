---
import BaseLayout from '../layouts/BaseLayout.astro';
import CityCard from '../components/CityCard.astro';
import StayLog from '../components/StayLog.astro';
import DispatchSignup from '../components/DispatchSignup.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { citiesByTrip, CITIES, COUNTRY_COUNT } from '../data/cities';
import { STAYS } from '../data/stays';
import { published } from '../data/flags';

const stays = published(STAYS);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Cities documented by CityboundNomad',
    numberOfItems: CITIES.length,
    itemListElement: CITIES.map((city, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'City',
        name: city.name,
        address: { '@type': 'PostalAddress', addressCountry: city.country },
      },
    })),
  },
];
---

<BaseLayout
  title={`Travel — ${CITIES.length} European Cities, Honest Costs | ${SITE.name}`}
  description={`City journals and honest stay reviews across ${CITIES.length} European cities in ${COUNTRY_COUNT} countries — real costs, real experience, and the places worth going back to.`}
  jsonLd={jsonLd}
>
  <div class="page-head">
    <div class="container">
      <p class="pillar-label mb-1">01 — Minimalist Solo Travel</p>
      <h1 class="display-xl mb-2">Cities, stays,<br /><em>honest costs.</em></h1>
      <p class="body-lg measure">
        City journals and honest stay reviews. {CITIES.length} cities across {COUNTRY_COUNT}
        countries — the real costs, the real experience, and the places worth going back to.
      </p>

      <div class="tabs" role="tablist" aria-label="Travel content">
        <button
          class="tab"
          role="tab"
          id="tab-cities"
          aria-controls="panel-cities"
          aria-selected="true"
        >
          <Icon name="map-pin" size={13} /> Cities
        </button>
        <button
          class="tab"
          role="tab"
          id="tab-stays"
          aria-controls="panel-stays"
          aria-selected="false"
        >
          <Icon name="bed" size={13} /> Stay Logs
        </button>
      </div>
    </div>
  </div>

  <!-- ─── Cities ───────────────────────────────────────────────────────── -->
  <section role="tabpanel" id="panel-cities" aria-labelledby="tab-cities" class="section">
    <div class="container">
      {
        citiesByTrip.map(({ trip, cities }, i) => (
          <div style={i > 0 ? 'margin-top:4.5rem' : ''}>
            <div class="mb-3">
              <p class="pillar-label mb-1">{trip.period}</p>
              <h2 class="display-md mb-1">{trip.label}</h2>
              <p class="body-lg measure-wide">{trip.blurb}</p>
            </div>
            <div class="cell-grid cell-grid--wide">
              {cities.map((city) => (
                <CityCard city={city} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ─── Stay logs ────────────────────────────────────────────────────── -->
  <section role="tabpanel" id="panel-stays" aria-labelledby="tab-stays" class="section" hidden>
    <div class="container" id="stays">
      {
        stays.length > 0 ? (
          <div class="cell-grid cell-grid--stack">
            {stays.map((stay) => (
              <StayLog stay={stay} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="The stay logs are being rewritten"
            body="Every review here has to come from a night actually spent in the place, with the price paid and the things that went wrong. The ones that did not meet that bar have been pulled. New ones go up as the notes get written."
          />
        )
      }

      {
        stays.length > 0 && (
          <p class="body-sm mt-3">
            Every stay log is written from a night actually spent there. Where a booking link earns
            a commission it is marked as such — see the{' '}
            <a href="/affiliate-disclosure" style="color:var(--c-accent)">
              affiliate disclosure
            </a>
            .
          </p>
        )
      }
    </div>
  </section>

  <section style="padding-bottom:5rem">
    <div class="container" style="max-width:640px">
      <DispatchSignup
        headline="Get the travel notes"
        subtext="Every city I visit, every stay I review, every cost breakdown — delivered to your inbox every Friday."
        source="travel"
      />
    </div>
  </section>
</BaseLayout>
