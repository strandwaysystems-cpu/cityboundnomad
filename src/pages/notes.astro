---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import { MILESTONES, ESSAYS, ESSAY_TYPE_LABELS } from '../data/journey';
import { published } from '../data/flags';

const essays = published(ESSAYS);
---

<BaseLayout
  title={`Notes — Why I Travel This Way | ${SITE.name}`}
  description="It started with a one-month Airbnb on Narva Mantee, Tallinn, in May 2022. The origin story, the trip timeline, and the thinking behind travelling light and staying longer."
>
  <div class="page-head">
    <div class="container">
      <div class="split split--wide-gap split--end">
        <div>
          <p class="pillar-label mb-1">03 — Notes</p>
          <h1 class="display-xl mb-2">Notes</h1>
          <p class="body-lg" style="max-width:480px">
            It started with a one-month Airbnb on Narva Mantee, Tallinn, in May 2022. This is where
            the longer writing goes — the origin story, the timeline, and why I do it this way.
            Written when there is something to say, not on a schedule.
          </p>
        </div>
        <div>
          <img
            src={IMAGES.journey}
            alt="Chandler in a European city"
            style="max-width:380px; height:380px; object-fit:cover; object-position:center 30%; margin-left:auto"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- ─── The philosophy ───────────────────────────────────────────────── -->
  <section class="section section--dark">
    <div class="container">
      <div class="split split--wide-gap" style="align-items:center">
        <blockquote class="pullquote">
          “I met people everywhere I went and fell in love with the European style, the laidback but
          functional lifestyle, and being in historic places.”
        </blockquote>
        <div>
          <p style="font-size:0.9375rem; color:var(--c-on-dark-soft); line-height:1.7; margin-bottom:1.5rem">
            Everything on this site comes from having been there. The cities are ones I've walked,
            the stays are nights I paid for, the things on the Things pages are in my bag right now.
            There is no research layer and no second-hand recommendation.
          </p>
          <p style="font-size:0.9375rem; color:var(--c-on-dark-soft); line-height:1.7">
            Which means it fills up slowly, and some pages are empty. Empty is the honest state for
            something I haven't written yet — it isn't a gap to be filled with an approximation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Essays ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow mb-3">Writing</p>
      {
        essays.length > 0 ? (
          <div class="cell-grid cell-grid--wide">
            {essays.map((essay) => {
              const hasBody = essay.body.length > 0;
              const Tag = hasBody ? 'a' : 'div';
              return (
                <Tag
                  class={`entry${hasBody ? ' card-hover' : ''}`}
                  href={hasBody ? `/notes/${essay.slug}` : undefined}
                  style="text-decoration:none; color:inherit; display:block"
                >
                  <div class="entry__meta">
                    <span class="entry__type" style="color:var(--c-accent)">
                      {ESSAY_TYPE_LABELS[essay.type]}
                    </span>
                    <span class="body-sm">
                      {essay.date} · {essay.readTime}
                    </span>
                  </div>
                  <h3>{essay.title}</h3>
                  <p class="body-sm">{essay.excerpt}</p>
                  {hasBody && (
                    <p class="link-cta mt-2">
                      Read it <Icon name="arrow-right" size={12} />
                    </p>
                  )}
                </Tag>
              );
            })}
          </div>
        ) : (
          <EmptyState
            title="Nothing published yet"
            body="The longer pieces get written slowly and only when there is something honest to say."
          />
        )
      }
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Timeline ─────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow mb-1">The Timeline</p>
          <h2 class="display-lg mb-2">How it actually went.</h2>
          <p class="body-lg">
            No overnight success story. A month in Tallinn, then Iceland, then a four-month run
            across Europe, then two more trips. Each one changed what the next one looked like.
          </p>
        </div>
        <div>
          <ol class="timeline">
            {
              MILESTONES.map((m) => (
                <li>
                  <p class="timeline__date">{m.date}</p>
                  <p class="body-lg" style="color:var(--c-ink)">
                    {m.label}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
