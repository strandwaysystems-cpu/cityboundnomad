---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SECTIONS } from '../data/site';
import { IMAGES } from '../data/images';
import { featuredCities, CITIES, COUNTRY_COUNT, citySlug } from '../data/cities';
import { CAFES } from '../data/cafes';
import { TOURS } from '../data/tours';
import { STAYS } from '../data/stays';
import { WARDROBE } from '../data/wardrobe';
import { GROOMING } from '../data/grooming';
import { published } from '../data/flags';

const SECTION_ICONS = ['map-pin', 'shirt', 'compass'] as const;

/* The homepage counts are computed, never written down — so a page that says
   "28 cities" can't drift out of sync with the data behind it. */
const COUNTS = [
  { value: CITIES.length, label: 'Cities' },
  { value: COUNTRY_COUNT, label: 'Countries' },
  { value: published(STAYS).length, label: 'Stays' },
  { value: published(CAFES).length + published(TOURS).length, label: 'Cafés & tours' },
  { value: published(WARDROBE).length + published(GROOMING).length, label: 'Things I use' },
];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <img src={IMAGES.hero} alt="A cobblestone street in Copenhagen at dusk" fetchpriority="high" />
    <div class="hero__scrim"></div>

    <div class="container hero__body">
      <p class="eyebrow hero__eyebrow">{SITE.tagline}</p>
      <h1 class="display-xl">This is the stuff,<br /><em>and these are the places.</em></h1>
      <p class="hero__lede">
        A running catalogue of somewhere I've actually been and something I've actually used.
        No research, no round-ups, nothing recommended second-hand.
      </p>
      <a class="btn-primary" href="/places">
        Start with the places
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </section>

  <!-- ─── What's here ──────────────────────────────────────────────────── -->
  <section class="section--lead">
    <div class="container">
      <div class="fade-in">
        <p class="eyebrow mb-1">What this is</p>
        <h2 class="display-lg mb-1">Everything here,<br /><em>I did or I own.</em></h2>
        <p class="body-lg measure mb-4">
          That's the whole rule. If a café is on this site I sat in it, if a tour is listed I went
          on it, and if something is in the wardrobe it's in my bag right now. It fills up slowly
          and some of it is still empty — which is the honest state for something I haven't written
          down yet.
        </p>
      </div>

      <div class="cell-grid cell-grid--3">
        {
          SECTIONS.map((section, i) => (
            <a class="pillar-card card-hover" href={section.href}>
              <p class="pillar-card__num">{section.num}</p>
              <div class="pillar-card__head">
                <Icon name={SECTION_ICONS[i]} size={14} color="var(--c-accent)" />
                <span class="pillar-label">{section.label}</span>
              </div>
              <p class="serif-lead mb-1">{section.tagline}</p>
              <p class="body-sm mb-2">{section.description}</p>
              <span class="card-arrow">
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Counts ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <dl class="stats">
        {
          COUNTS.map((c) => (
            <div>
              <dd class="stat__value">{c.value}</dd>
              <dt class="stat__label">{c.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Places ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="fade-in" style="display:grid; gap:3rem">
        <div>
          <p class="pillar-label mb-1">01 — Places</p>
          <h2 class="display-lg mb-1">From Reykjavik<br /><em>to Chania.</em></h2>
          <p class="body-lg measure mb-3">
            {CITIES.length} cities across {COUNTRY_COUNT} countries, grouped by the trip they belong
            to. Each has its own page — what it cost, where I slept, what was worth the day.
          </p>
          <a class="btn-ghost" href="/places">All places</a>
        </div>

        <div class="cell-grid cell-grid--cards">
          {
            featuredCities.map((city) => (
              <a class="tile card-hover" href={`/places/${citySlug(city.name)}`}>
                {city.image && (
                  <div class="zoom-frame">
                    <img
                      src={city.image}
                      alt={`${city.name}, ${city.country}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="tile__body">
                  <p class="tile__name">{city.name}</p>
                  <p class="body-sm">
                    {city.country} · €{city.costPerDayMin}–€{city.costPerDayMax}/day
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Things ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="cell-grid cell-grid--wide fade-in">
        <a class="feature-card card-hover" href="/things">
          <div class="zoom-frame" style="height:260px">
            <img src={IMAGES.style} alt="An all-black travel outfit" loading="lazy" decoding="async" />
          </div>
          <div class="feature-card__body">
            <p class="pillar-label mb-1">02 — Things</p>
            <h3 class="display-md mb-1">All black, one bag,<br /><em>no compromises.</em></h3>
            <p class="body-sm">
              The wardrobe that fits in 26 litres, the hair and skin routine, the gear. Listed
              honestly, replaced rarely.
            </p>
          </div>
          <span class="card-arrow"><Icon name="arrow-right" size={16} /></span>
        </a>

        <a class="feature-card card-hover" href="/notes">
          <div class="zoom-frame" style="height:260px">
            <img src={IMAGES.journey} alt="Chandler in a European cafe" loading="lazy" decoding="async" />
          </div>
          <div class="feature-card__body">
            <p class="pillar-label mb-1">03 — Notes</p>
            <h3 class="display-md mb-1">Why I do it<br /><em>this way.</em></h3>
            <p class="body-sm">
              It started with a one-month Airbnb in Tallinn in May 2022. The origin story, the
              timeline, and the thinking behind travelling light and staying longer.
            </p>
          </div>
          <span class="card-arrow"><Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Quote ────────────────────────────────────────────────────────── -->
  <section class="section section--dark">
    <div class="container">
      <blockquote class="pullquote">
        “It's funny how it feels like you did nothing the past year… until you look back at your
        camera roll.”
      </blockquote>
      <p class="pullquote__attr">— Chandler, December 2022</p>
    </div>
  </section>
</BaseLayout>
