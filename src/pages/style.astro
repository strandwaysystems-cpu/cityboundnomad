---
import BaseLayout from '../layouts/BaseLayout.astro';
import DispatchSignup from '../components/DispatchSignup.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import { PRINCIPLES, CAPSULE, CAPSULE_CATEGORY_ORDER, STYLE_POSTS } from '../data/style';
import { published } from '../data/flags';

const capsule = published(CAPSULE);
const posts = published(STYLE_POSTS);

const capsuleGroups = CAPSULE_CATEGORY_ORDER.map((category) => ({
  category,
  items: capsule.filter((item) => item.category === category),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title={`Style — Scandinavian Men's Style, One Bag | ${SITE.name}`}
  description="Functionality-first dressing. One bag. A monochromatic palette that works in every city, every context, every season."
>
  <div class="page-head" style="padding-bottom:0; border-bottom:none">
    <div class="container">
      <div class="split split--wide-gap split--end" style="padding-bottom:4rem; border-bottom:1px solid var(--c-line)">
        <div>
          <p class="pillar-label mb-1">02 — Scandinavian Men's Style</p>
          <h1 class="display-xl mb-2">Style</h1>
          <p class="body-lg" style="max-width:480px">
            Functionality-first dressing. One bag. A monochromatic palette that works in every city,
            every context, every season. The aesthetic identity of the minimalist travel life.
          </p>
        </div>
        <div>
          <img
            src={IMAGES.style}
            alt="An all-black travel outfit"
            style="max-width:360px; height:420px; object-fit:cover; object-position:center 15%; margin-left:auto"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Principles ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow mb-3">The Principles</p>
      <div class="cell-grid cell-grid--tight">
        {
          PRINCIPLES.map((p) => (
            <div style="padding:2rem">
              <p class="pillar-card__num" style="font-size:3rem">
                {p.num}
              </p>
              <h2 class="display-sm mb-1">{p.title}</h2>
              <p class="body-sm">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── The capsule ──────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow mb-1">The Capsule</p>
          <h2 class="display-lg mb-2">Everything I own,<br /><em>in 26 litres.</em></h2>
          <p class="body-lg">
            The whole wardrobe, listed. Nothing goes in the bag that can't be worn three ways, and
            nothing stays in it that hasn't earned the space.
          </p>
        </div>

        <div>
          {
            capsuleGroups.length > 0 ? (
              capsuleGroups.map((group) => (
                <div class="capsule-group">
                  <h3>{group.category}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li class="capsule-item">
                        <span>
                          <span style="display:block; font-weight:500">{item.name}</span>
                          <span class="body-sm">
                            {item.brand} · {item.notes}
                          </span>
                        </span>
                        <span class="capsule-item__price">{item.price}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            ) : (
              <EmptyState
                title="The capsule list is being rebuilt"
                body="This section lists what is genuinely in the bag right now — brands, prices, and how many of each. It goes back up once the current pack is written down properly rather than approximated."
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Gear notes ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow mb-3">Gear Notes</p>
      {
        posts.length > 0 ? (
          <div class="cell-grid cell-grid--wide">
            {posts.map((post) => (
              <article class="entry">
                <p class="body-sm mb-1">
                  {post.date} · {post.readTime}
                </p>
                <h3>{post.title}</h3>
                <p class="body-sm">{post.excerpt}</p>
              </article>
            ))}
          </div>
        ) : (
          <EmptyState
            title="No gear reviews published yet"
            body="Only things worn long enough to have an opinion about get written up here — which means the first reviews are still accumulating miles. The Dispatch gets them first."
          />
        )
      }
    </div>
  </section>

  <section style="padding-bottom:5rem">
    <div class="container" style="max-width:640px">
      <DispatchSignup
        headline="Style notes, weekly"
        subtext="What I'm wearing, what's working, what I'm replacing. Capsule updates from the road, every Friday."
        source="style"
      />
    </div>
  </section>
</BaseLayout>
